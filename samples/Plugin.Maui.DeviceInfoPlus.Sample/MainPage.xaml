<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plugin.Maui.DeviceInfoPlus.Sample.MainPage"
             Title="DeviceInfoPlus">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="10">
            <Label Text="Plugin.Maui.DeviceInfoPlus" FontSize="22" FontAttributes="Bold" />
            <Label Text="Fingerprint · capabilities · telemetry JSON"
                   TextColor="Gray" />

            <Label x:Name="StatusLabel" FontSize="13" LineBreakMode="WordWrap" />

            <HorizontalStackLayout Spacing="8">
                <Button Text="Get snapshot" Clicked="OnGetClicked" />
                <Button Text="Refresh" Clicked="OnRefreshClicked" />
            </HorizontalStackLayout>

            <Label Text="Capabilities" FontAttributes="Bold" Margin="0,8,0,0" />
            <Label x:Name="CapabilitiesLabel" FontSize="14" LineBreakMode="WordWrap" />

            <Label Text="JSON" FontAttributes="Bold" Margin="0,8,0,0" />
            <Label x:Name="JsonLabel" FontFamily="Courier New" FontSize="12" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
